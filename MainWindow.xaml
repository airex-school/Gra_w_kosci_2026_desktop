<Window x:Class="Gra_w_kosci_2026_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gra_w_kosci_2026_desktop"
        mc:Ignorable="d"
        Title="Gra w kości"
        Height="600"
        Width="300"
        Background="#ED27C121">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,10">

            <Image x:Name="Obrazek1"
                   Source="/Obrazki/kosc0.png"
                   Width="70"
                   Height="70"
                   Margin="10"/>

            <Image x:Name="Obrazek2"
                   Source="/Obrazki/kosc0.png"
                   Width="70"
                   Height="70"
                   Margin="10"/>

        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Image x:Name="Obrazek3"
                   Source="/Obrazki/kosc0.png"
                   Width="70"
                   Height="70"
                   Margin="10"/>

            <Image x:Name="Obrazek4"
                   Source="/Obrazki/kosc0.png"
                   Width="70"
                   Height="70"
                   Margin="10"/>

            <Image x:Name="Obrazek5"
                   Source="/Obrazki/kosc0.png"
                   Width="70"
                   Height="70"
                   Margin="10"/>

        </StackPanel>

        <Button Margin="10" Background="#ED275021" Foreground="White" Height="35" Width="75" Click="Rzut">RZUT</Button>
        <TextBlock x:Name="Wynik" Text="0" TextAlignment="Center" FontSize="40"></TextBlock>
    
    </StackPanel>

</Window>
